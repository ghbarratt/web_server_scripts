# General settings
DESTINATION_PATH_FOR_BACKUP=/var/www/backup
VERBOSE_DEFAULT=FALSE
DEBUGGING_DEFAULT=FALSE

# backup_directory script settings
# 0 means to keep all on keep counts
DIRECTORY_DAILIES_TO_KEEP_COUNT_DEFAULT=7
DIRECTORY_MONTHLIES_TO_KEEP_COUNT_DEFAULT=6
DIRECTORY_YEARLIES_TO_KEEP_COUNT_DEFAULT=0
DIRECTORY_TIMELIES_TO_KEEP_COUNT_DEFAULT=5

# make_database_dumps script settings 
# DESTINATION_PATH_FOR_BACKUP is used
# DB_TYPE 'postgres', 'mariadb', or 'mysql' (auto-detected if unset)
# Standard PostgreSQL connection variables (optional; defaults to local connection)
#PGHOST=localhost
#PGPORT=5432
#PGUSER=postgres

