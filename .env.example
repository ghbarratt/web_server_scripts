# General settings
DESTINATION_PATH_FOR_BACKUP=/var/www/backup
VERBOSE_DEFAULT=FALSE
DEBUGGING_DEFAULT=FALSE

# Retention settings convention:
#   0   = disabled (do not create or keep)
#   N   = keep N newest backups
#   all = keep all indefinitely (never delete)

# backup_directory script settings
DIRECTORY_TIMELIES_TO_KEEP_COUNT_DEFAULT=5
DIRECTORY_DAILIES_TO_KEEP_COUNT_DEFAULT=7
DIRECTORY_MONTHLIES_TO_KEEP_COUNT_DEFAULT=6
DIRECTORY_YEARLIES_TO_KEEP_COUNT_DEFAULT=all

# make_database_dumps script settings
# DESTINATION_PATH_FOR_BACKUP is used
DATABASE_DAILIES_TO_KEEP_COUNT=7
DATABASE_MONTHLIES_TO_KEEP_COUNT=6
DATABASE_YEARLIES_TO_KEEP_COUNT=all

# DB_TYPE: 'postgres', 'mariadb', or 'mysql' (auto-detected if unset)
# Standard PostgreSQL connection variables (optional; defaults to local Unix socket)
#PGHOST=localhost
#PGPORT=5432
#PGUSER=postgres
